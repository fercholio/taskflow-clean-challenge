@{
	Layout = null;
	var apiBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>TaskFlow API</title>
	<style>
		body { font-family: system-ui, sans-serif; max-width: 720px; margin: 3rem auto; padding: 0 1rem; color: #1a1a1a; }
		h1 { margin-bottom: .25rem; }
		code { background: #f3f3f3; padding: .15rem .4rem; border-radius: 4px; }
		a.btn { display: inline-block; margin-top: 1rem; padding: .6rem 1rem; background: #2563eb; color: white; text-decoration: none; border-radius: 6px; }
		ul li { margin: .25rem 0; }
		.demo { background: #fef3c7; padding: .75rem 1rem; border-radius: 6px; margin-top: 1rem; }
	</style>
</head>
<body>
	<h1>TaskFlow API</h1>
	<p>Clean Architecture .NET 9 Web API + MVC. Persistence via raw Npgsql (no EF/Dapper/MediatR).</p>

	<div class="demo">
		<strong>Demo credentials:</strong> <code>demo@taskflow.dev</code> / <code>Demo123!</code>
	</div>

	<h2>Try it</h2>
	<ul>
		<li><a href="/swagger">Swagger UI</a> — interactive API docs.</li>
		<li><code>POST /api/v1/auth/login</code> — get a JWT.</li>
		<li><code>GET /api/v1/tasks</code> — list tasks (requires <code>Authorization: Bearer …</code>).</li>
		<li><code>GET /api/v1/ping</code> — anonymous health check.</li>
		<li><code>GET /api/v1/ping/secure</code> — authorized echo.</li>
	</ul>

	<a class="btn" href="/swagger">Open Swagger UI</a>
</body>
</html>
